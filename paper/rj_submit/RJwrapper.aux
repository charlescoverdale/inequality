\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Lorenz curves for three synthetic income distributions with low, medium, and high inequality. Each series is a lognormal sample of 2000 observations. Distributions share the same geometric mean and differ only in dispersion. Dashed diagonal is the line of perfect equality. Each Gini is twice the area between its curve and the diagonal.}}{3}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:lorenz}{{1}{3}{Lorenz curves for three synthetic income distributions with low, medium, and high inequality. Each series is a lognormal sample of 2000 observations. Distributions share the same geometric mean and differ only in dispersion. Dashed diagonal is the line of perfect equality. Each Gini is twice the area between its curve and the diagonal}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Mean 95 per cent Davidson bootstrap CI width for the Gini coefficient as a function of sample size. At each sample size the CI is computed on 40 independent lognormal draws (mu = 10.5, sigma = 0.8), each with 400 bootstrap replications. Sample sizes on the log scale. CI half-width falls by a factor of roughly six between n = 100 and n = 5000.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:gini-ci}{{2}{4}{Mean 95 per cent Davidson bootstrap CI width for the Gini coefficient as a function of sample size. At each sample size the CI is computed on 40 independent lognormal draws (mu = 10.5, sigma = 0.8), each with 400 bootstrap replications. Sample sizes on the log scale. CI half-width falls by a factor of roughly six between n = 100 and n = 5000}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.5}Decomposition and income shares}{4}{section.2.5}\protected@file@percent }
\newlabel{decomposition-and-income-shares}{{2.5}{4}{Decomposition and income shares}{section.2.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Bourguignon between-within decomposition of Theil T across three grouping scenarios. Each scenario has 1500 observations in three groups with identical within-group dispersion (sigma = 0.6 lognormal) but different group-mean spread. Left bar: group means GBP 30k / 32k / 34k, between share 0.6 per cent. Middle bar: group means 25k / 35k / 55k. Right bar: group means 18k / 40k / 80k, between share 45 per cent. The between-within split is an immediate diagnostic for how much inequality is explained by the grouping variable.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:decompose}{{3}{5}{Bourguignon between-within decomposition of Theil T across three grouping scenarios. Each scenario has 1500 observations in three groups with identical within-group dispersion (sigma = 0.6 lognormal) but different group-mean spread. Left bar: group means GBP 30k / 32k / 34k, between share 0.6 per cent. Middle bar: group means 25k / 35k / 55k. Right bar: group means 18k / 40k / 80k, between share 45 per cent. The between-within split is an immediate diagnostic for how much inequality is explained by the grouping variable}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.6}Poverty and growth incidence}{5}{section.2.6}\protected@file@percent }
\newlabel{poverty-and-growth-incidence}{{2.6}{5}{Poverty and growth incidence}{section.2.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Growth incidence curve on the package's synthetic panel dataset. Data from \texttt  {iq\_sample\_data("panel")}: 1000 individuals across two periods, lognormal returns with heterogeneous growth (lower percentiles grow more slowly). Annualised growth rate at each 5-percentile bin is plotted against the base-period percentile rank. Dashed line is the mean annualised growth rate across the full distribution. The curve's upward slope signals inequality-increasing growth over the period.}}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:gic}{{4}{6}{Growth incidence curve on the package's synthetic panel dataset. Data from \texttt {iq\_sample\_data("panel")}: 1000 individuals across two periods, lognormal returns with heterogeneous growth (lower percentiles grow more slowly). Annualised growth rate at each 5-percentile bin is plotted against the base-period percentile rank. Dashed line is the mean annualised growth rate across the full distribution. The curve's upward slope signals inequality-increasing growth over the period}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.7}Fiscal redistribution and polarisation}{6}{section.2.7}\protected@file@percent }
\newlabel{fiscal-redistribution-and-polarisation}{{2.7}{6}{Fiscal redistribution and polarisation}{section.2.7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.8}A case study on the inequality verdict}{6}{section.2.8}\protected@file@percent }
\newlabel{a-case-study-on-the-inequality-verdict}{{2.8}{6}{A case study on the inequality verdict}{section.2.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Atkinson index as a function of inequality-aversion parameter epsilon for two distributions. Blue solid: a single lognormal sample, n = 3000. Red dashed: a mixture, 85 per cent moderate lognormal plus 15 per cent high-mean high-variance lognormal, total n = 3000. At epsilon = 0.5 the two distributions score similarly; at epsilon = 2 the mixture distribution scores more than double the lognormal, reflecting the heavier top tail. The two distributions have Gini coefficients 0.41 and 0.56 respectively.}}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:atkinson}{{5}{7}{Atkinson index as a function of inequality-aversion parameter epsilon for two distributions. Blue solid: a single lognormal sample, n = 3000. Red dashed: a mixture, 85 per cent moderate lognormal plus 15 per cent high-mean high-variance lognormal, total n = 3000. At epsilon = 0.5 the two distributions score similarly; at epsilon = 2 the mixture distribution scores more than double the lognormal, reflecting the heavier top tail. The two distributions have Gini coefficients 0.41 and 0.56 respectively}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.9}A case study of six-country inequality trajectories}{7}{section.2.9}\protected@file@percent }
\newlabel{a-case-study-of-six-country-inequality-trajectories}{{2.9}{7}{A case study of six-country inequality trajectories}{section.2.9}{}}
\citation{atkinson2008changing,piketty2014capital}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Gini coefficient by country from the World Bank Poverty and Inequality Platform, each series from its first available year through 2024. Data: World Bank series \texttt  {SI.POV.GINI}. Brazil shows the well-documented post-Bolsa-Familia decline from 57.9 in 1981 to 50.3 in 2024. The United States shows a steady rise from 37 in 1970 to 42 in 2024. Sweden, France, and the UK are broadly in the 25 to 33 band throughout. Germany data begins 1991 after reunification.}}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:wb-gini}{{6}{8}{Gini coefficient by country from the World Bank Poverty and Inequality Platform, each series from its first available year through 2024. Data: World Bank series \texttt {SI.POV.GINI}. Brazil shows the well-documented post-Bolsa-Familia decline from 57.9 in 1981 to 50.3 in 2024. The United States shows a steady rise from 37 in 1970 to 42 in 2024. Sweden, France, and the UK are broadly in the 25 to 33 band throughout. Germany data begins 1991 after reunification}{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces First-year and last-year Gini plus total change for six countries in the World Bank Poverty and Inequality Platform panel. Ordered by latest observed Gini, ascending. Change is the last-year Gini minus the first-year Gini in percentage points.}}{8}{table.caption.8}\protected@file@percent }
\newlabel{tab:wb-summary}{{1}{8}{First-year and last-year Gini plus total change for six countries in the World Bank Poverty and Inequality Platform panel. Ordered by latest observed Gini, ascending. Change is the last-year Gini minus the first-year Gini in percentage points}{table.caption.8}{}}
\@writefile{brf}{\backcite{atkinson2008changing}{{8}{2.9}{table.caption.8}}}
\@writefile{brf}{\backcite{piketty2014capital}{{8}{2.9}{table.caption.8}}}
