\newlabel{replication}{{2.10}{8}{Replication}{section.2.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Twelve inequality indices for the package's synthetic income sample. Output of \texttt  {iq\_compare(iq\_sample\_data("income")\$income)}. Gini and Theil agree on the total magnitude; the S-Gini raises the weight on rank differences; Atkinson rises sharply with inequality aversion; Palma ratio captures the 10/40 tail concentration; P90/P10 gives the most intuitive read. The Kolm index is absolute rather than relative and is reported in the income units of the sample, so its magnitude is not comparable with the scale-invariant indices above it.}}{9}{table.caption.9}\protected@file@percent }
\newlabel{tab:compare}{{2}{9}{Twelve inequality indices for the package's synthetic income sample. Output of \texttt {iq\_compare(iq\_sample\_data("income")\$income)}. Gini and Theil agree on the total magnitude; the S-Gini raises the weight on rank differences; Atkinson rises sharply with inequality aversion; Palma ratio captures the 10/40 tail concentration; P90/P10 gives the most intuitive read. The Kolm index is absolute rather than relative and is reported in the income units of the sample, so its magnitude is not comparable with the scale-invariant indices above it}{table.caption.9}{}}
